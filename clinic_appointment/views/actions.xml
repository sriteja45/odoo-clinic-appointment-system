<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Actions extracted so they load before views that reference them -->

    <record id="action_clinic_employee" model="ir.actions.act_window">
            <field name="name">Clinic Employees</field>
            <field name="res_model">clinic.employee</field>
            <field name="view_mode">kanban,list,form</field>
        </record>

    <record id="action_clinic_doctors" model="ir.actions.act_window">
            <field name="name">Doctors</field>
            <field name="res_model">clinic.employee</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('role','=','doctor')]</field>
        </record>

    <record id="action_clinic_receptionists" model="ir.actions.act_window">
            <field name="name">Receptionists</field>
            <field name="res_model">clinic.employee</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('role','=','receptionist')]</field>
        </record>

    <record id="action_clinic_nurses" model="ir.actions.act_window">
            <field name="name">Nurses</field>
            <field name="res_model">clinic.employee</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('role','=','nurse')]</field>
        </record>

    <record id="action_clinic_lab" model="ir.actions.act_window">
            <field name="name">Lab Technicians</field>
            <field name="res_model">clinic.employee</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('role','=','lab')]</field>
        </record>

    <record id="action_clinic_other_staff" model="ir.actions.act_window">
            <field name="name">Other Staff</field>
            <field name="res_model">clinic.employee</field>
            <field name="view_mode">kanban,list,form</field>
            <field name="domain">[('role','=','other')]</field>
        </record>

    <record id="action_clinic_patient" model="ir.actions.act_window">
            <field name="name">Patients</field>
            <field name="res_model">clinic.patient</field>
            <field name="view_mode">list,form</field>
        </record>

    <record id="action_clinic_enquiry" model="ir.actions.act_window">
            <field name="name">Patient Enquiries</field>
            <field name="res_model">clinic.enquiry</field>
            <field name="view_mode">list,form</field>
        </record>

    <record id="action_hospital_room" model="ir.actions.act_window">
            <field name="name">Rooms</field>
            <field name="res_model">hospital.room</field>
            <field name="view_mode">list,form</field>
        </record>

    <record id="action_room_booking" model="ir.actions.act_window">
            <field name="name">Room Booking</field>
            <field name="res_model">hospital.room.booking</field>
            <field name="view_mode">list,form</field>
        </record>

    <record id="action_occupied_rooms" model="ir.actions.act_window">
            <field name="name">Occupied Rooms</field>
            <field name="res_model">hospital.room</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('status','=','occupied')]</field>
            <field name="context">{'create': False}</field>
        </record>

    <record id="action_cleaning_rooms" model="ir.actions.act_window">
            <field name="name">Cleaning Rooms</field>
            <field name="res_model">hospital.room</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('status','=','cleaning')]</field>
            <field name="context">{'create': False}</field>
        </record>

    <record id="action_live_chat_dashboard" model="ir.actions.act_window">
            <field name="name">Live Chat Dashboard</field>
            <field name="res_model">clinic.chat.session</field>
            <field name="view_mode">list,form</field>
            <field name="domain">[('doctor_id.user_id', '=', uid), ('status', 'in', ['waiting', 'active'])]</field>
            <field name="target">current</field>
        </record>


    <record id="action_next_patient" model="ir.actions.server">
            <field name="name">Next Patient</field>
            <field name="model_id" ref="model_clinic_appointment"/>
            <field name="state">code</field>
            <field name="code"><![CDATA[
        action = env['clinic.appointment'].action_next_patient()
        ]]></field>
        </record>

</odoo>
